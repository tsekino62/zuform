export const snapshot = {};

snapshot[`サーバーレスAPIテンプレート(dev)のスナップショット 1`] = `
'# ============================================================
# 環境: DEV
# このファイルは Zuform で作成した構成図から自動生成されました
# 実行方法（この環境のディレクトリで）:
#   terraform init   … 初回のみ。プラグインをダウンロード
#   terraform plan   … 何が作成されるかを事前確認
#   terraform apply  … 実際にAWSへリソースを作成
#   terraform destroy … 作成したリソースをすべて削除
# ============================================================

terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.region

  # このファイルが作る全リソースに共通タグを自動付与する
  default_tags {
    tags = {
      Project     = "myapp"
      Environment = "dev"
      ManagedBy   = "terraform"
    }
  }
}

variable "region" {
  description = "リソースを作成するAWSリージョン"
  type        = string
  default     = "ap-northeast-1" # 東京リージョン
}

# ---------- DynamoDBテーブル: items-table ----------

resource "aws_dynamodb_table" "items_table" {
  name         = "myapp-dev-items-table"
  billing_mode = "PAY_PER_REQUEST" # 使った分だけ課金（初心者におすすめ）
  hash_key     = "id"              # 主キー。必要に応じて変更してください

  attribute {
    name = "id"
    type = "S" # S = 文字列型
  }

  tags = { Name = "myapp-dev-items-table" }
}

# ---------- Lambda関数: items-handler ----------

# Lambdaが実行時に使うIAMロール（権限のセット）
resource "aws_iam_role" "items_handler_role" {
  name = "myapp-dev-items-handler-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

# CloudWatch Logsへログを書き込む基本権限
resource "aws_iam_role_policy_attachment" "items_handler_basic" {
  role       = aws_iam_role.items_handler_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

# DynamoDBテーブル「items-table」への読み書き権限
resource "aws_iam_role_policy" "items_handler_items_table_access" {
  name = "myapp-dev-items-handler-items-table-access"
  role = aws_iam_role.items_handler_role.id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
      ]
      Resource = aws_dynamodb_table.items_table.arn
    }]
  })
}

resource "aws_lambda_function" "items_handler" {
  function_name = "myapp-dev-items-handler"
  role          = aws_iam_role.items_handler_role.arn

  runtime = "python3.12"
  handler = "index.lambda_handler" # index.py の lambda_handler 関数を実行

  # ここにデプロイパッケージ(zip)を配置してください。
  # 例: mkdir -p build && cd src && zip -r ../build/items_handler.zip .
  filename = "build/items_handler.zip"

  timeout = 10

  # 接続先の情報を環境変数としてLambdaのコードに渡す
  environment {
    variables = {
      TABLE_NAME = aws_dynamodb_table.items_table.name
    }
  }
}
# ---------- API Gateway: items-api ----------

resource "aws_apigatewayv2_api" "items_api" {
  name          = "myapp-dev-items-api"
  protocol_type = "HTTP" # シンプルで低コストなHTTP API
}

# \$default ステージ（デプロイ先）。auto_deployで変更が即時反映される
resource "aws_apigatewayv2_stage" "items_api_default" {
  api_id      = aws_apigatewayv2_api.items_api.id
  name        = "\$default"
  auto_deploy = true
}

# Lambda「items-handler」との接続
resource "aws_apigatewayv2_integration" "items_api_items_handler" {
  api_id                 = aws_apigatewayv2_api.items_api.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.items_handler.invoke_arn
  payload_format_version = "2.0"
}

# すべてのリクエストをこのLambdaへ
resource "aws_apigatewayv2_route" "items_api_items_handler" {
  api_id    = aws_apigatewayv2_api.items_api.id
  route_key = "\$default"
  target    = "integrations/\${aws_apigatewayv2_integration.items_api_items_handler.id}"
}

# API GatewayがこのLambdaを呼び出すことを許可
resource "aws_lambda_permission" "items_api_items_handler" {
  statement_id  = "AllowInvokeFrom-myapp-dev-items-api"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.items_handler.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "\${aws_apigatewayv2_api.items_api.execution_arn}/*/*"
}
# ---------- 出力（apply後に表示される値） ----------

output "items_api_endpoint" {
  description = "items-api のURL（apply後にブラウザやcurlでアクセスできます）"
  value       = aws_apigatewayv2_api.items_api.api_endpoint
}
'
`;

snapshot[`RDB構成テンプレート: devとprdで環境プロファイルが異なる 1`] = `
'# ============================================================
# 環境: PRD
# このファイルは Zuform で作成した構成図から自動生成されました
# 実行方法（この環境のディレクトリで）:
#   terraform init   … 初回のみ。プラグインをダウンロード
#   terraform plan   … 何が作成されるかを事前確認
#   terraform apply  … 実際にAWSへリソースを作成
#   terraform destroy … 作成したリソースをすべて削除
# ============================================================

terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.region

  # このファイルが作る全リソースに共通タグを自動付与する
  default_tags {
    tags = {
      Project     = "myapp"
      Environment = "prd"
      ManagedBy   = "terraform"
    }
  }
}

variable "region" {
  description = "リソースを作成するAWSリージョン"
  type        = string
  default     = "ap-northeast-1" # 東京リージョン
}

# ---------- 変数 ----------

variable "db_password" {
  description = "RDSデータベースの管理者パスワード（terraform apply時に入力）"
  type        = string
  sensitive   = true # 実行ログに表示されないようにする
}

# ---------- VPC: app-vpc ----------

resource "aws_vpc" "app_vpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true

  tags = { Name = "myapp-prd-app-vpc" }
}

# インターネットへの出入口
resource "aws_internet_gateway" "app_vpc_igw" {
  vpc_id = aws_vpc.app_vpc.id

  tags = { Name = "myapp-prd-app-vpc-igw" }
}

# パブリックサブネット（インターネットから到達可能）
resource "aws_subnet" "app_vpc_public_a" {
  vpc_id                  = aws_vpc.app_vpc.id
  cidr_block              = "10.0.0.0/24"
  availability_zone       = "\${var.region}a"
  map_public_ip_on_launch = true

  tags = { Name = "myapp-prd-app-vpc-public-a" }
}

# プライベートサブネット（DBなど外部公開しないリソース用・2AZ分）
resource "aws_subnet" "app_vpc_private_a" {
  vpc_id            = aws_vpc.app_vpc.id
  cidr_block        = "10.0.10.0/24"
  availability_zone = "\${var.region}a"

  tags = { Name = "myapp-prd-app-vpc-private-a" }
}

resource "aws_subnet" "app_vpc_private_c" {
  vpc_id            = aws_vpc.app_vpc.id
  cidr_block        = "10.0.11.0/24"
  availability_zone = "\${var.region}c"

  tags = { Name = "myapp-prd-app-vpc-private-c" }
}

# パブリックサブネット用のルートテーブル
resource "aws_route_table" "app_vpc_public" {
  vpc_id = aws_vpc.app_vpc.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.app_vpc_igw.id
  }

  tags = { Name = "myapp-prd-app-vpc-public-rt" }
}

resource "aws_route_table_association" "app_vpc_public_a" {
  subnet_id      = aws_subnet.app_vpc_public_a.id
  route_table_id = aws_route_table.app_vpc_public.id
}

# ---------- Lambda関数: get-users ----------

# Lambdaが実行時に使うIAMロール（権限のセット）
resource "aws_iam_role" "get_users_role" {
  name = "myapp-prd-get-users-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

# CloudWatch Logsへログを書き込む基本権限
resource "aws_iam_role_policy_attachment" "get_users_basic" {
  role       = aws_iam_role.get_users_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

# VPC内で動作するための権限
resource "aws_iam_role_policy_attachment" "get_users_vpc" {
  role       = aws_iam_role.get_users_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
}

# Lambda用のセキュリティグループ
resource "aws_security_group" "get_users_sg" {
  name   = "myapp-prd-get-users-sg"
  vpc_id = aws_vpc.app_vpc.id

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "myapp-prd-get-users-sg" }
}

resource "aws_lambda_function" "get_users" {
  function_name = "myapp-prd-get-users"
  role          = aws_iam_role.get_users_role.arn

  runtime = "python3.12"
  handler = "index.lambda_handler" # index.py の lambda_handler 関数を実行

  # ここにデプロイパッケージ(zip)を配置してください。
  # 例: mkdir -p build && cd src && zip -r ../build/get_users.zip .
  filename = "build/get_users.zip"

  timeout = 10

  # 接続先の情報を環境変数としてLambdaのコードに渡す
  environment {
    variables = {
      DB_HOST     = aws_db_instance.users_db.address
      DB_NAME     = aws_db_instance.users_db.db_name
      DB_USER     = aws_db_instance.users_db.username
      DB_PASSWORD = var.db_password # 本番ではSecrets Managerの利用を推奨
    }
  }

  # VPC内のリソース（RDSなど）へアクセスするための設定
  vpc_config {
    subnet_ids         = [aws_subnet.app_vpc_private_a.id, aws_subnet.app_vpc_private_c.id]
    security_group_ids = [aws_security_group.get_users_sg.id]
  }
}
# ---------- RDS (MySQL): users-db ----------

# DBを配置するサブネットのグループ（2つ以上のAZが必要）
resource "aws_db_subnet_group" "users_db" {
  name       = "myapp-prd-users-db-subnets"
  subnet_ids = [aws_subnet.app_vpc_private_a.id, aws_subnet.app_vpc_private_c.id]

  tags = { Name = "myapp-prd-users-db-subnets" }
}

# DBへの通信を制御するファイアウォール
resource "aws_security_group" "users_db_sg" {
  name   = "myapp-prd-users-db-sg"
  vpc_id = aws_vpc.app_vpc.id

  # Lambda「get-users」からの接続を許可
  ingress {
    from_port       = 3306
    to_port         = 3306
    protocol        = "tcp"
    security_groups = [aws_security_group.get_users_sg.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "myapp-prd-users-db-sg" }
}

resource "aws_db_instance" "users_db" {
  identifier        = "myapp-prd-users-db"
  engine            = "mysql"
  engine_version    = "8.0"
  instance_class    = "db.t3.small"
  allocated_storage = 20 # ストレージ 20GB

  db_name  = "app"
  username = "admin"
  password = var.db_password

  db_subnet_group_name   = aws_db_subnet_group.users_db.name
  vpc_security_group_ids = [aws_security_group.users_db_sg.id]

  multi_az                = true # 2つのAZに冗長化（本番向け）
  backup_retention_period = 7 # 自動バックアップの保持日数
  deletion_protection     = true # 誤削除を防止
  skip_final_snapshot     = false # 削除時に最終スナップショットを取得

  publicly_accessible = false # インターネットから直接アクセスさせない
}

# ---------- API Gateway: user-api ----------

resource "aws_apigatewayv2_api" "user_api" {
  name          = "myapp-prd-user-api"
  protocol_type = "HTTP" # シンプルで低コストなHTTP API
}

# \$default ステージ（デプロイ先）。auto_deployで変更が即時反映される
resource "aws_apigatewayv2_stage" "user_api_default" {
  api_id      = aws_apigatewayv2_api.user_api.id
  name        = "\$default"
  auto_deploy = true
}

# Lambda「get-users」との接続
resource "aws_apigatewayv2_integration" "user_api_get_users" {
  api_id                 = aws_apigatewayv2_api.user_api.id
  integration_type       = "AWS_PROXY"
  integration_uri        = aws_lambda_function.get_users.invoke_arn
  payload_format_version = "2.0"
}

# すべてのリクエストをこのLambdaへ
resource "aws_apigatewayv2_route" "user_api_get_users" {
  api_id    = aws_apigatewayv2_api.user_api.id
  route_key = "\$default"
  target    = "integrations/\${aws_apigatewayv2_integration.user_api_get_users.id}"
}

# API GatewayがこのLambdaを呼び出すことを許可
resource "aws_lambda_permission" "user_api_get_users" {
  statement_id  = "AllowInvokeFrom-myapp-prd-user-api"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.get_users.function_name
  principal     = "apigateway.amazonaws.com"
  source_arn    = "\${aws_apigatewayv2_api.user_api.execution_arn}/*/*"
}
# ---------- 出力（apply後に表示される値） ----------

output "users_db_endpoint" {
  description = "users-db の接続先ホスト名"
  value       = aws_db_instance.users_db.address
}

output "user_api_endpoint" {
  description = "user-api のURL（apply後にブラウザやcurlでアクセスできます）"
  value       = aws_apigatewayv2_api.user_api.api_endpoint
}
'
`;
