{
  "tasks": {
    "dev": "deno run -A npm:vite@8",
    "build": "deno run -A npm:vite@8 build",
    "preview": "deno run -A npm:vite@8 preview",
    "check": "deno check src/",
    "test": "deno test -A src/",
    "test:update": "deno test -A src/ -- --update",
    "fixtures": "deno run -A scripts/emit_fixtures.ts",
    "ext:build": "deno task build && cd vscode-ext && npm install --silent && npm run build"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true
  },
  "imports": {
    "react": "npm:react@^19.2.0",
    "react/jsx-runtime": "npm:react@^19.2.0/jsx-runtime",
    "react-dom": "npm:react-dom@^19.2.0",
    "react-dom/client": "npm:react-dom@^19.2.0/client",
    "@types/react": "npm:@types/react@^19.2.0",
    "@xyflow/react": "npm:@xyflow/react@^12.8.0",
    "fflate": "npm:fflate@^0.8.2",
    "vite": "npm:vite@^8.2.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^5.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "yaml": "npm:yaml@^2.5.0",
    "@dagrejs/dagre": "npm:@dagrejs/dagre@^1.1.0"
  },
  "exclude": ["dist/"]
}
