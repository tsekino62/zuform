{
  "name": "zuform-vscode",
  "displayName": "Zuform",
  "description": "Draw AWS architecture diagrams and generate Terraform for dev/stg/prd — AWS構成図からTerraformを生成",
  "version": "0.1.0",
  "publisher": "tsekino62",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsekino62/zuform.git",
    "directory": "vscode-ext"
  },
  "bugs": {
    "url": "https://github.com/tsekino62/zuform/issues"
  },
  "homepage": "https://github.com/tsekino62/zuform#readme",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1b2130",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "terraform",
    "aws",
    "diagram",
    "infrastructure as code",
    "iac",
    "architecture",
    "devops",
    "cloud"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "zuform.diagram",
        "displayName": "Zuform 構成図",
        "selector": [
          {
            "filenamePattern": "*.awsarch.yaml"
          },
          {
            "filenamePattern": "*.awsdiagram.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "zuform.newDiagram",
        "title": "Zuform: 新しい構成図を作成"
      }
    ]
  },
  "scripts": {
    "copy-media": "node copy-media.mjs",
    "build": "npm run copy-media && node build.mjs",
    "watch": "npm run copy-media && node build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
